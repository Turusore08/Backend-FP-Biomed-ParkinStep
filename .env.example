APP_ENV=development
APP_NAME=ParkinStep Companion API
APP_VERSION=1.0.0
DATABASE_URL=postgresql+asyncpg://parkinstep:CHANGE_ME@localhost:5432/parkinstep
JWT_SECRET_KEY=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_SEC=900
JWT_REFRESH_TOKEN_TTL_DAYS=30
AUTH_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_SEC=60
IDEMPOTENCY_TTL_HOURS=168
OTA_APP_KEY=
MODEL_CDN_BASE_URL=https://models.parkinstep.example.org/bundles
MAX_VIDEO_UPLOAD_BYTES=31457280
VIDEO_TEMP_DIR=
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
